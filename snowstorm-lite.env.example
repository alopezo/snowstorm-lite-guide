# Snowstorm Lite — archivo de entorno (PLANTILLA)
#
# 1. Copia este archivo a:  snowstorm-lite.env   (misma carpeta que docker-compose.yml)
# 2. Reemplaza los valores de ejemplo de abajo.
# 3. Ejecuta:  docker compose up -d
#
# NOTA: mantén privado el snowstorm-lite.env real — tiene credenciales.
#       NO lo subas a un repo ni lo compartas en un gist.

# --- Cuenta admin (requerida) -------------------------------------------------
# Credenciales del login admin usado por el dashboard y la API admin.
# El usuario es "admin" si se omite; pon siempre tu propia contraseña.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiame

# --- Sindicación MLDS (opcional) ----------------------------------------------
# Solo hace falta si quieres que Snowstorm Lite descargue automáticamente una edición
# SNOMED CT desde el servicio MLDS de SNOMED International (https://mlds.ihtsdotools.org).
# Déjalas en blanco si vas a importar un paquete RF2 a mano.
#
# ATENCIÓN: los valores se toman LITERALES (docker no procesa el archivo con la shell).
#   - NO pongas comillas alrededor del valor.
#   - NO escapes caracteres especiales con "\". Si tu contraseña es  ab*c$d  escribe
#     exactamente  ab*c$d  (no  ab\*c\$d ). Un "\" de más rompe la credencial y la
#     descarga del ZIP falla con 401.
SYNDICATION_USERNAME=tu-usuario-mlds
SYNDICATION_PASSWORD=tu-password-mlds
