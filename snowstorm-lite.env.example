# Snowstorm Lite — environment file (TEMPLATE)
#
# 1. Copy this file to:  snowstorm-lite.env   (same folder as docker-compose.yml)
# 2. Replace the example values below.
# 3. Run:  docker compose up -d
#
# NOTE: keep the real snowstorm-lite.env private — it holds credentials.
#       Do NOT commit it to a repo or share it in a gist.

# --- Admin account (required) -------------------------------------------------
# Credentials for the admin login used by the dashboard and the admin API.
# The username is "admin" if omitted; always set your own password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# --- MLDS Syndication (optional) ----------------------------------------------
# Only needed if you want Snowstorm Lite to auto-download a SNOMED CT edition from
# SNOMED International's MLDS service (https://mlds.ihtsdotools.org).
# Leave blank if you'll import an RF2 package by hand.
#
# HEADS UP: values are taken LITERALLY (docker does not run this file through a shell).
#   - Do NOT put quotes around the value.
#   - Do NOT escape special characters with "\". If your password is  ab*c$d  write
#     exactly  ab*c$d  (not  ab\*c\$d ). A stray "\" breaks the credential and the
#     ZIP download fails with 401.
SYNDICATION_USERNAME=your-mlds-username
SYNDICATION_PASSWORD=your-mlds-password
